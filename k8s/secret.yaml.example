# Copy to secret.yaml, fill in the real data-host private IP, then:
#   kubectl apply -f k8s/secret.yaml
# Regenerate this every time the data host is destroyed/recreated — its
# private IP changes, same reason ansible/inventory.ini is gitignored too.
apiVersion: v1
kind: Secret
metadata:
  name: ghosthref-secrets
type: Opaque
stringData:
  PG_HOST: REPLACE_WITH_DATA_HOST_PRIVATE_IP
  PG_USER: ghosthref
  PG_PASSWORD: ghosthref
  PG_DATABASE: ghosthref
  REDIS_HOST: REPLACE_WITH_DATA_HOST_PRIVATE_IP
