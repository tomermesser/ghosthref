# Holds the bouncer's DB/Redis connection info — copy to secret.yaml, fill in the data host's private IP, then kubectl apply.
apiVersion: v1
kind: Secret
metadata:
  name: ghosthref-secrets
type: Opaque
stringData:
  PG_HOST: REPLACE_WITH_DATA_HOST_PRIVATE_IP
  PG_USER: ghosthref
  PG_PASSWORD: ghosthref
  PG_DATABASE: ghosthref
  REDIS_HOST: REPLACE_WITH_DATA_HOST_PRIVATE_IP
